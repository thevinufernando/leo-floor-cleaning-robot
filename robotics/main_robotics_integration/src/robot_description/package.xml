<?xml version="1.0"?>
<package format="3">
  <name>robot_description</name>
  <version>0.1.0</version>
  <description>URDF/xacro model and TF tree for the differential-drive cleaning robot</description>

  <maintainer email="thevinuworks1@gmail.com">thevinufpi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <!-- GUI/visualization deps: only needed on the dev machine (WSL2) running
       display.launch.py with use_rviz/use_gui true. Not installed on the
       Pi (Ubuntu Server, headless). See NETWORK_SETUP.md. -->
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
